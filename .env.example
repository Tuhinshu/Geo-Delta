# ==============================================================================
# GeoDelta GEOINT Platform - Environment Configuration
# Target: MoD SIH26227 Air-Gapped Deployment
# ==============================================================================

# System & Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="GeoDelta Automated GEOINT Platform"
API_V1_PREFIX=/api/v1
SECRET_KEY=geodelta-tactical-secret-key-mod-sih26227-airgapped-auth

# PostgreSQL + PostGIS 3.4
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=geodelta_admin
POSTGRES_PASSWORD=geodelta_secure_pass_2026
POSTGRES_DB=geodelta_geoint
DATABASE_URL=postgresql+asyncpg://geodelta_admin:geodelta_secure_pass_2026@db:5432/geodelta_geoint
SYNC_DATABASE_URL=postgresql://geodelta_admin:geodelta_secure_pass_2026@db:5432/geodelta_geoint

# Redis Task Broker & Cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# MinIO Local S3 Object Store
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secure_pass_2026
MINIO_BUCKET_COGS=cog-rasters
MINIO_BUCKET_DOSSIERS=dossiers
MINIO_BUCKET_MODELS=model-weights
MINIO_USE_SSL=false

# TiTiler Dynamic Raster XYZ Proxy
TITILER_ENDPOINT=http://titiler:8000

# GPU & Hardware Acceleration
CUDA_VISIBLE_DEVICES=0
DEVICE=cuda
MODEL_WEIGHTS_DIR=/models/weights
MAX_GPU_MEMORY_ALLOCATION_MB=7500

# Security & CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ACCESS_TOKEN_EXPIRE_MINUTES=480
